%%% 表・図のタイトルをゴシックにする＆呼び出し方の定義 
\def\fref#1{\textgt{図\ \ref{#1}}}
\def\tref#1{\textgt{表\ \ref{#1}}}
\def\eref#1{\textgt{式\ (\ref{#1})}}


%%% 表・図のタイトルをゴシックにする． 
\def\caption{\refstepcounter\@captype \@dblarg{\@caption\@captype}} 
\long\def\@caption#1[#2]#3{\par%
  \addcontentsline{\csname ext@#1\endcsname}{#1}{%
  \protect\numberline{\csname the#1\endcsname}{\ignorespaces #2}}%
  \begingroup\@parboxrestore\normalsize\@makecaption{ \textgt{\csname fnum@#1\endcsname}}{\ignorespaces \textgt{#3}}\par\endgroup}


