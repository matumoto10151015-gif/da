\usepackage{float}
\usepackage[most]{tcolorbox}

\newtcblisting{brokenlisting}[4][]{
  listing engine=listings,
  listing only,
  breakable, 
  % ↓↓↓ [breaklines=true] をここに追加しました！これにより右へのはみ出しを自動折り返しします
  listing options={style=mylst, language=Python, #1},
  colback=white,
  colframe=black,
  boxrule=0.5pt,
  sharp corners,
  top=2mm, bottom=2mm, left=2mm, right=2mm,
  before skip=10pt,
  after skip=25pt, 
  code={\refstepcounter{figure}\if\relax\detokenize{#4}\relax\else\label{#4}\fi},
  overlay unbroken={
    \node[anchor=north, font=\small\bfseries] at ([yshift=-2mm]frame.south) {図\thefigure\quad #2\quad （1/#3）};
  },
  overlay first={
    \node[anchor=north, font=\small\bfseries] at ([yshift=-2mm]frame.south) {図\thefigure\quad #2\quad （1/#3）};
  },
  overlay middle={
    \node[anchor=north, font=\small\bfseries] at ([yshift=-2mm]frame.south) {図\thefigure\quad #2\quad （\thetcbbreakpart/#3）};
  },
  overlay last={
    \node[anchor=north, font=\small\bfseries] at ([yshift=-2mm]frame.south) {図\thefigure\quad #2\quad （\thetcbbreakpart/#3）};
  }
}


%%% ---- minted の代わりに listings を使う設定（コンパイル高速化） ----
\lstdefinestyle{mylst}{
  basicstyle=\ttfamily\small,
  breaklines=true,
  breakatwhitespace=false,
  columns=fullflexible,
  keepspaces=true,
  showstringspaces=false,
  frame=single,
  xleftmargin=0pt,
  aboveskip=0pt,
  belowskip=0pt
}
\lstset{style=mylst}
% 言語名の対応（minted名 -> listings名）
\def\mintlang@cpp{\lstset{language=C++}}
\def\mintlang@python{\lstset{language=Python}}
\def\mintlang@c{\lstset{language=C}}
\def\mintlang@java{\lstset{language=Java}}
% 既存の \begin{minted}[オプション]{言語} をそのまま使えるようにする互換環境
\lstnewenvironment{minted}[2][]{%
  \lstset{style=mylst}\csname mintlang@#2\endcsname}{}

%%% 参考文献番号の自動採番（本文に登場した順に[1],[2],...を割り当てる）
\newcounter{refcnt}\newcounter{refsec}
\let\refdo\relax
\gdef\citedlist{}
\newcommand{\resetrefs}{%
  \global\c@refcnt=0\relax
  \global\advance\c@refsec by 1\relax
  \gdef\citedlist{}}
\newcommand{\myrefdef}[2]{\expandafter\gdef\csname refdef@#1\endcsname{#2}}
\DeclareRobustCommand{\mycite}[1]{%
  \ifcsname refnum@\number\c@refsec @#1\endcsname\else
    \global\advance\c@refcnt by 1\relax
    \expandafter\xdef\csname refnum@\number\c@refsec @#1\endcsname{\number\c@refcnt}%
    \xdef\citedlist{\citedlist\noexpand\refdo{#1}}%
  \fi
  \textsuperscript{[\csname refnum@\number\c@refsec @#1\endcsname]}}
\newcommand{\printrefs}{%
  \begin{enumerate}%
    \def\refdo##1{\item\csname refdef@##1\endcsname}%
    \citedlist
  \end{enumerate}}
